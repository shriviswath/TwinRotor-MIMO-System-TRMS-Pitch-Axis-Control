#include <stdint.h>
#include <stdbool.h>
#include <math.h>
#include "inc/hw_memmap.h"
#include "inc/hw_types.h"
#include "inc/hw_gpio.h"
#include "driverlib/sysctl.h"
#include "driverlib/gpio.h"
#include "driverlib/pwm.h"
#include "driverlib/pin_map.h"
#include "driverlib/uart.h"
#include "driverlib/i2c.h"
#include "driverlib/fpu.h"
#include "uartstdio.h"

// ── PWM ────────────────────────────────────────────────────
#define PWM_PERIOD      12500
#define ESC_MIN         625     // emergency-stop floor only
#define ESC_IDLE        695     // WORKING FLOOR — real bottom of useful range
#define ESC_MAX         1250

// ── Output limits ──────────────────────────────────────────
#define LQR_AUTHORITY       200     // max |u| in PWM ticks (symmetric)
#define MOTOR_SMOOTHING     0.15f   // IIR — provides natural soft-landing

// ── IMU ────────────────────────────────────────────────────
#define MPU_ADDR        0x68
#define ACCEL_SCALE     16384.0f
#define GYRO_SCALE      131.0f
#define DT              0.01f
#define COMP_ALPHA      0.98f

// ── LQR Gains ──────────────────────────────────────────────
//  K1 (KP-like): gentle proportional return.  Don't make this
//      too high — it competes with K2 and causes overshoot.
//  K2 (KD-like): THE BRAKE.  This is what stops the beam when
//      it's moving fast toward (or past) the setpoint.  Higher
//      K2 = stronger damping = softer landing.
//  K3 (KI-like): learns steady-state offset.  Keep small.
// ──────────────────────────────────────────────────────────
#define K1              0.6f
#define K2              1.5f        // ← strong damping is the brake
#define K3              0.0f        // start at 0; add later if needed

#define DEAD_BAND       0.5f
#define INTEGRAL_MAX    25.0f
#define IMU_SETTLE_MS   3000

// ── Globals ────────────────────────────────────────────────
static float gyro_bias_x        = 0.0f;
static float gyro_bias_z        = 0.0f;
static float g_pitch_rate       = 0.0f;
static float g_yaw              = 0.0f;

static float lqr_integral       = 0.0f;
static float lqr_output_smooth  = 0.0f;

static float pwm_m1             = ESC_MIN;
static float pwm_m2             = ESC_MIN;


// ============================================================
//  Helpers
// ============================================================
static float clampf_val(float v, float lo, float hi)
{
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

static float fabsf_safe(float v) { return v < 0.0f ? -v : v; }

static void delay_ms(uint32_t ms)
{
    SysCtlDelay((SysCtlClockGet() / 3000) * ms);
}

static void printFloat(const char *label, float v)
{
    int32_t a = (int32_t)v;
    int32_t b = (int32_t)((v - (float)a) * 100.0f);
    if (b < 0) b = -b;
    UARTprintf("%s%d.%02d", label, a, b);
}

static void printBanner(void)
{
    UARTprintf("  K1=");
    printFloat("", K1);
    UARTprintf("  K2=");
    printFloat("", K2);
    UARTprintf("  K3=");
    printFloat("", K3);
    UARTprintf("\n");
}


// ============================================================
//  I2C
// ============================================================
static void I2C_Write(uint8_t reg, uint8_t data)
{
    I2CMasterSlaveAddrSet(I2C0_BASE, MPU_ADDR, false);
    I2CMasterDataPut(I2C0_BASE, reg);
    I2CMasterControl(I2C0_BASE, I2C_MASTER_CMD_BURST_SEND_START);
    while (I2CMasterBusy(I2C0_BASE));
    I2CMasterDataPut(I2C0_BASE, data);
    I2CMasterControl(I2C0_BASE, I2C_MASTER_CMD_BURST_SEND_FINISH);
    while (I2CMasterBusy(I2C0_BASE));
}

static void I2C_Read(uint8_t reg, uint8_t *buf, uint8_t len)
{
    I2CMasterSlaveAddrSet(I2C0_BASE, MPU_ADDR, false);
    I2CMasterDataPut(I2C0_BASE, reg);
    I2CMasterControl(I2C0_BASE, I2C_MASTER_CMD_SINGLE_SEND);
    while (I2CMasterBusy(I2C0_BASE));

    I2CMasterSlaveAddrSet(I2C0_BASE, MPU_ADDR, true);
    int i;
    for (i = 0; i < len; i++)
    {
        if      (len == 1)     I2CMasterControl(I2C0_BASE, I2C_MASTER_CMD_SINGLE_RECEIVE);
        else if (i == 0)       I2CMasterControl(I2C0_BASE, I2C_MASTER_CMD_BURST_RECEIVE_START);
        else if (i == len - 1) I2CMasterControl(I2C0_BASE, I2C_MASTER_CMD_BURST_RECEIVE_FINISH);
        else                   I2CMasterControl(I2C0_BASE, I2C_MASTER_CMD_BURST_RECEIVE_CONT);
        while (I2CMasterBusy(I2C0_BASE));
        buf[i] = I2CMasterDataGet(I2C0_BASE);
    }
}


// ============================================================
//  IMU
// ============================================================
static void updateAngle(float *pitch)
{
    uint8_t buf[6];

    I2C_Read(0x3B, buf, 6);
    float ay = (float)((int16_t)((buf[2] << 8) | buf[3])) / ACCEL_SCALE;
    float az = (float)((int16_t)((buf[4] << 8) | buf[5])) / ACCEL_SCALE;

    I2C_Read(0x43, buf, 6);
    float gx = (float)((int16_t)((buf[0] << 8) | buf[1])) / GYRO_SCALE - gyro_bias_x;
    float gz = (float)((int16_t)((buf[4] << 8) | buf[5])) / GYRO_SCALE - gyro_bias_z;

    g_pitch_rate = gx;

    float accel_angle = (180.0f / 3.14159265f) * (atan2f(ay, az) + 3.14159265f);
    if (accel_angle > 180.0f) accel_angle -= 360.0f;
    *pitch = COMP_ALPHA * (*pitch + gx * DT) + (1.0f - COMP_ALPHA) * accel_angle;

    g_yaw += gz * DT;
}


// ============================================================
//  Gyro Calibration
// ============================================================
static void calibrateGyro(void)
{
    UARTprintf("Calibrating gyro -- keep beam STILL...\n");
    delay_ms(2000);

    float sum_x = 0.0f, sum_z = 0.0f;
    uint8_t buf[6];
    int i;
    for (i = 0; i < 500; i++)
    {
        I2C_Read(0x43, buf, 6);
        sum_x += (float)((int16_t)((buf[0] << 8) | buf[1])) / GYRO_SCALE;
        sum_z += (float)((int16_t)((buf[4] << 8) | buf[5])) / GYRO_SCALE;
        delay_ms(4);
    }
    gyro_bias_x = sum_x / 500.0f;
    gyro_bias_z = sum_z / 500.0f;

    printFloat("  Bias_X=", gyro_bias_x);
    printFloat("  Bias_Z=", gyro_bias_z);
    UARTprintf(" deg/s\n\n");
}


// ============================================================
//  LQR Reset
// ============================================================
static void resetLQR(void)
{
    lqr_integral        = 0.0f;
    lqr_output_smooth   = 0.0f;
}


// ============================================================
//  MAIN
// ============================================================
int main(void)
{
    FPUEnable();
    FPULazyStackingEnable();

    SysCtlClockSet(SYSCTL_SYSDIV_5 | SYSCTL_USE_PLL |
                   SYSCTL_OSC_MAIN | SYSCTL_XTAL_16MHZ);
    SysCtlPWMClockSet(SYSCTL_PWMDIV_64);

    SysCtlPeripheralEnable(SYSCTL_PERIPH_PWM0);
    SysCtlPeripheralEnable(SYSCTL_PERIPH_GPIOA);
    SysCtlPeripheralEnable(SYSCTL_PERIPH_GPIOB);
    SysCtlPeripheralEnable(SYSCTL_PERIPH_GPIOF);
    SysCtlPeripheralEnable(SYSCTL_PERIPH_UART0);
    SysCtlPeripheralEnable(SYSCTL_PERIPH_I2C0);

    while (!SysCtlPeripheralReady(SYSCTL_PERIPH_GPIOA));
    while (!SysCtlPeripheralReady(SYSCTL_PERIPH_GPIOB));
    while (!SysCtlPeripheralReady(SYSCTL_PERIPH_GPIOF));

    HWREG(GPIO_PORTF_BASE + GPIO_O_LOCK) = GPIO_LOCK_KEY;
    HWREG(GPIO_PORTF_BASE + GPIO_O_CR)  |= GPIO_PIN_0;
    HWREG(GPIO_PORTF_BASE + GPIO_O_LOCK) = 0x00;

    GPIOPinConfigure(GPIO_PA0_U0RX);
    GPIOPinConfigure(GPIO_PA1_U0TX);
    GPIOPinTypeUART(GPIO_PORTA_BASE, GPIO_PIN_0 | GPIO_PIN_1);
    UARTStdioConfig(0, 115200, SysCtlClockGet());

    GPIOPinTypeGPIOOutput(GPIO_PORTF_BASE, GPIO_PIN_1 | GPIO_PIN_2 | GPIO_PIN_3);
    GPIOPinTypeGPIOInput(GPIO_PORTF_BASE, GPIO_PIN_4 | GPIO_PIN_0);
    GPIOPadConfigSet(GPIO_PORTF_BASE, GPIO_PIN_4,
                     GPIO_STRENGTH_2MA, GPIO_PIN_TYPE_STD_WPU);
    GPIOPadConfigSet(GPIO_PORTF_BASE, GPIO_PIN_0,
                     GPIO_STRENGTH_2MA, GPIO_PIN_TYPE_STD_WPU);

    GPIOPinConfigure(GPIO_PB2_I2C0SCL);
    GPIOPinConfigure(GPIO_PB3_I2C0SDA);
    GPIOPinTypeI2CSCL(GPIO_PORTB_BASE, GPIO_PIN_2);
    GPIOPinTypeI2C(GPIO_PORTB_BASE, GPIO_PIN_3);
    I2CMasterInitExpClk(I2C0_BASE, SysCtlClockGet(), false);

    I2C_Write(0x6B, 0x00);
    I2C_Write(0x1A, 0x03);
    I2C_Write(0x1B, 0x00);
    I2C_Write(0x1C, 0x00);
    delay_ms(100);

    GPIOPinConfigure(GPIO_PB6_M0PWM0);
    GPIOPinConfigure(GPIO_PB7_M0PWM1);
    GPIOPinTypePWM(GPIO_PORTB_BASE, GPIO_PIN_6 | GPIO_PIN_7);
    PWMGenConfigure(PWM0_BASE, PWM_GEN_0,
                    PWM_GEN_MODE_DOWN | PWM_GEN_MODE_NO_SYNC);
    PWMGenPeriodSet(PWM0_BASE, PWM_GEN_0, PWM_PERIOD);

    PWMPulseWidthSet(PWM0_BASE, PWM_OUT_0, ESC_MIN);
    PWMPulseWidthSet(PWM0_BASE, PWM_OUT_1, ESC_MIN);
    PWMOutputState(PWM0_BASE, PWM_OUT_0_BIT | PWM_OUT_1_BIT, true);
    PWMGenEnable(PWM0_BASE, PWM_GEN_0);

    UARTprintf("\n========================================\n");
    UARTprintf("  TRMS PITCH LQR \n");
    printBanner();
    UARTprintf("  ESC_IDLE (working floor) = %d\n", ESC_IDLE);
    UARTprintf("========================================\n\n");

    uint8_t who;
    I2C_Read(0x75, &who, 1);
    if (who == 0x68 || who == 0x70)
        UARTprintf("MPU6050 OK (0x%02X)\n\n", (unsigned)who);
    else
    {
        UARTprintf("MPU6050 FAIL (got 0x%02X)\n", (unsigned)who);
        while (1);
    }

    calibrateGyro();
    g_yaw = 0.0f;

    uint8_t sbuf[6];
    I2C_Read(0x3B, sbuf, 6);
    float ay0    = (float)((int16_t)((sbuf[2] << 8) | sbuf[3])) / ACCEL_SCALE;
    float az0    = (float)((int16_t)((sbuf[4] << 8) | sbuf[5])) / ACCEL_SCALE;
    float accel0 = (180.0f / 3.14159265f) * (atan2f(ay0, az0) + 3.14159265f);
    if (accel0 > 180.0f) accel0 -= 360.0f;
    float pitch = accel0;
    printFloat("Initial Pitch=", pitch);
    UARTprintf(" deg\n");

    UARTprintf("IMU settling (%d s)...\n", IMU_SETTLE_MS / 1000);
    uint32_t settle_loops = IMU_SETTLE_MS / 10;
    uint32_t sl;
    for (sl = 0; sl < settle_loops; sl++)
    {
        updateAngle(&pitch);
        if (sl % 100 == 0)
        {
            UARTprintf("  ");
            printFloat("Pitch=", pitch);
            UARTprintf("\n");
        }
        delay_ms(10);
    }
    printFloat("Settled. Final Pitch=", pitch);
    UARTprintf(" deg\n\n");

    GPIOPinWrite(GPIO_PORTF_BASE, GPIO_PIN_2, GPIO_PIN_2);
    UARTprintf("Connect battery - hear beeps - press SW1\n");
    while (GPIOPinRead(GPIO_PORTF_BASE, GPIO_PIN_4) != 0);
    delay_ms(300);
    GPIOPinWrite(GPIO_PORTF_BASE, GPIO_PIN_2, 0);
    UARTprintf("Armed.\n\n");

    UARTprintf("Ramping to working floor (%d)...\n", ESC_IDLE);
    uint32_t r;
    for (r = ESC_MIN; r <= ESC_IDLE; r++)
    {
        PWMPulseWidthSet(PWM0_BASE, PWM_OUT_0, r);
        PWMPulseWidthSet(PWM0_BASE, PWM_OUT_1, r);
        delay_ms(3);
    }
    pwm_m1 = pwm_m2 = (float)ESC_IDLE;

    UARTprintf("Settling under motor load (3 s)...\n");
    int ws;
    for (ws = 0; ws < 300; ws++)
    {
        updateAngle(&pitch);
        delay_ms(10);
    }

    GPIOPinWrite(GPIO_PORTF_BASE, GPIO_PIN_2, GPIO_PIN_2);
    UARTprintf("Hold beam at desired angle - press SW1\n");
    while (GPIOPinRead(GPIO_PORTF_BASE, GPIO_PIN_4) != 0);
    delay_ms(300);
    GPIOPinWrite(GPIO_PORTF_BASE, GPIO_PIN_2, 0);

    float sp_sum = 0.0f;
    int sp;
    for (sp = 0; sp < 100; sp++)
    {
        updateAngle(&pitch);
        sp_sum += pitch;
        delay_ms(10);
    }
    float setpoint = sp_sum / 100.0f;
    resetLQR();

    GPIOPinWrite(GPIO_PORTF_BASE, GPIO_PIN_3, GPIO_PIN_3);
    printFloat("Setpoint=", setpoint);
    UARTprintf(" deg\n\n");

    UARTprintf("LQR ACTIVE. SW2 = EMERGENCY STOP.\n\n");
    UARTprintf("Pitch=  Rate=  Intg=  PWM=  Error=\n");
    UARTprintf("-----------------------------------------------\n");

    uint32_t print_count = 0;

    // ── MAIN LOOP ─────────────────────────────────────────
    while (1)
    {
        // ── 1. Update IMU ──────────────────────────────────
        updateAngle(&pitch);

        // ── 2. LQR State Vector ────────────────────────────
        float x1 = setpoint - pitch;    // position error
        float x2 = g_pitch_rate;        // pitch rate

        float eff_x1 = (fabsf_safe(x1) < DEAD_BAND) ? 0.0f : x1;

        // ── 3. Integral state ──────────────────────────────
        if (fabsf_safe(eff_x1) > DEAD_BAND && fabsf_safe(eff_x1) < 5.0f)
            lqr_integral += eff_x1 * DT;
        else if (fabsf_safe(eff_x1) >= 10.0f)
            lqr_integral *= 0.95f;
        lqr_integral = clampf_val(lqr_integral, -INTEGRAL_MAX, INTEGRAL_MAX);
        float x3 = lqr_integral;

        // ── 4. LQR Control Law ─────────────────────────────
        //  u = K1*x1 - K2*x2 + K3*x3
        //
        //  When the beam is moving FAST toward setpoint from
        //  above (x2 negative, x1 negative going to zero), the
        //  -K2*x2 term becomes large negative, REDUCING u below
        //  what the proportional term alone would say.  This
        //  keeps PWM low during the descent and lets the beam
        //  glide in.  When motion stops (x2 → 0), u rises back
        //  to whatever P+I want — gentle hand-off.
        //
        float raw_output = (K1 * eff_x1) - (K2 * x2) + (K3 * x3);
        raw_output = clampf_val(raw_output,
                                -(float)LQR_AUTHORITY,
                                 (float)LQR_AUTHORITY);

        lqr_output_smooth = raw_output;   // no extra smoothing — let K2 do its job

        // ── 5. Motor Command ───────────────────────────────
        //
        //  Both motors track together (collective).
        //  PWM = ESC_IDLE + u, clamped at ESC_IDLE on the bottom.
        //
        //  NO RATE LIMITER.  The MOTOR_SMOOTHING IIR provides
        //  natural first-order lag; K2 provides active damping.
        //  Together they replace the rate limiter without its
        //  side-effect of slowing PWM rise during recovery.
        //
        float target_pwm = (float)ESC_IDLE + lqr_output_smooth;
        target_pwm = clampf_val(target_pwm, (float)ESC_IDLE, (float)ESC_MAX);

        // IIR smoothing — the only motion filter
        pwm_m1 = (MOTOR_SMOOTHING * target_pwm) + ((1.0f - MOTOR_SMOOTHING) * pwm_m1);
        pwm_m2 = pwm_m1;

        PWMPulseWidthSet(PWM0_BASE, PWM_OUT_0, (uint32_t)pwm_m1);
        PWMPulseWidthSet(PWM0_BASE, PWM_OUT_1, (uint32_t)pwm_m2);

        // ── 6. LED Feedback ────────────────────────────────
        float abs_err = fabsf_safe(x1);
        if      (abs_err < DEAD_BAND)
            GPIOPinWrite(GPIO_PORTF_BASE,
                         GPIO_PIN_1|GPIO_PIN_2|GPIO_PIN_3, GPIO_PIN_3);
        else if (abs_err < 10.0f)
            GPIOPinWrite(GPIO_PORTF_BASE,
                         GPIO_PIN_1|GPIO_PIN_2|GPIO_PIN_3, GPIO_PIN_2);
        else
            GPIOPinWrite(GPIO_PORTF_BASE,
                         GPIO_PIN_1|GPIO_PIN_2|GPIO_PIN_3, GPIO_PIN_1);

        // ── 7. Telemetry ───────────────────────────────────
        print_count++;
        if (print_count >= 10)        // 100 ms — faster than v4 to catch transients
        {
            print_count = 0;
            printFloat("Pitch=", pitch);
            printFloat("  Rate=", x2);
            printFloat("  Intg=", x3);
            UARTprintf("  PWM=%d  ", (int)pwm_m1);
            printFloat("Error=", x1);
            UARTprintf("\n");
        }

        // ── 8. Emergency Stop (SW2) ────────────────────────
        if (GPIOPinRead(GPIO_PORTF_BASE, GPIO_PIN_0) == 0)
        {
            uint32_t cur = (uint32_t)pwm_m1;
            while (cur > ESC_MIN)
            {
                if (cur < 2) break;
                cur -= 2;
                PWMPulseWidthSet(PWM0_BASE, PWM_OUT_0, cur);
                PWMPulseWidthSet(PWM0_BASE, PWM_OUT_1, cur);
                delay_ms(5);
            }
            GPIOPinWrite(GPIO_PORTF_BASE,
                         GPIO_PIN_1|GPIO_PIN_2|GPIO_PIN_3, GPIO_PIN_1);
            UARTprintf("\n!!! EMERGENCY STOP !!!\n");
            while (1);
        }

        delay_ms(10);
    }
}

// ============================================================
//  TUNING GUIDE 
//
//  EXPECTED BEHAVIOR — beam at 0°, setpoint 20°:
//    Pitch=2°    PWM=702   Rate=+12   ← climbing
//    Pitch=14°   PWM=708   Rate=+30   ← still climbing, K2 starting to brake
//    Pitch=20°   PWM=695   Rate=+8    ← K2 cut PWM as beam neared target
//    Pitch=22°   PWM=695   Rate=-3    ← slight overshoot, K2 still pulling down
//    Pitch=21°   PWM=697   Rate=-1    ← settled near setpoint
//
//  IF IT OSCILLATES SAME AS V4:
//    - Raise K2 to 2.0 — more damping
//    - Or lower K1 to 0.4 — less proportional kick
//
//  IF IT'S TOO SLUGGISH (won't reach setpoint):
//    - K2 is too high relative to K1
//    - Raise K1 to 0.8, or lower K2 to 1.0
//
//  IF STEADY-STATE ERROR:
//    - Add K3 = 0.05 to learn the offset
